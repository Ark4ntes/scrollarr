# Copiez ce fichier en « .env » puis adaptez les valeurs.

# Adresses des serveurs vues depuis le conteneur, sans barre oblique finale.
# Renseignez l'un, l'autre ou les deux ; laissez vide celui que vous n'utilisez pas.
# - Par l'adresse du NAS si le serveur publie son port (192.168.1.10 est un exemple, mettez la vôtre)
# - Par son nom de conteneur si les piles partagent un réseau Docker : http://suwayomi:4567
SUWAYOMI_URL=http://ADRESSE_DU_NAS:4567
KOMGA_URL=

# Service Dossiers (profil « folders », facultatif) : mettez http://folders:8788 pour l'utiliser,
# et choisissez son mode d'authentification plus bas (FOLDERS_AUTH est obligatoire).
FOLDERS_URL=

# Version des images publiées (déploiement sans clone, avec deploy/docker-compose.yml).
# « latest » suit la dernière version ; un numéro (0.9.0, ou 0.9 pour rester sur une série) la fige.
SCROLLARR_VERSION=latest

# Port d'écoute de Scrollarr sur l'hôte.
SCROLLARR_PORT=8380

# ── Notifications push (profil « push », facultatif) ──
# Suwayomi : seulement s'il demande une authentification.
SUWAYOMI_USER=
SUWAYOMI_PASSWORD=
# Komga : clé d'API créée dans Mon compte > Clés d'API.
KOMGA_API_KEY=
# Contact exigé par le protocole Web Push.
VAPID_SUBJECT=mailto:vous@exemple.fr
# Intervalle entre deux vérifications des nouveaux chapitres.
POLL_MINUTES=10

# ── Service Dossiers (profil « folders », facultatif) ──
# Dossier des scans sur l'hôte, monté en lecture seule (un dossier = une bibliothèque).
FOLDERS_SCANS_PATH=./scans
# Obligatoire : « password » (identifiant et mot de passe de 12 caractères au moins) ou « none » (aucun contrôle,
# réseau local de confiance seulement). Le service refuse de démarrer sans l'un des deux.
FOLDERS_AUTH=
FOLDERS_USER=
FOLDERS_PASSWORD=
# Utilisateur du conteneur (propriétaire de data/folders).
FOLDERS_UID=1000
FOLDERS_GID=1000
