# Copiez ce fichier en « .env » puis adaptez les valeurs.

# Adresses des serveurs vues depuis le conteneur, sans barre oblique finale.
# Renseignez l'un, l'autre ou les deux ; laissez vide celui que vous n'utilisez pas.
# - Par l'adresse du NAS si le serveur publie son port (192.168.1.10 est un exemple, mettez la vôtre)
# - Par son nom de conteneur si les piles partagent un réseau Docker : http://suwayomi:4567
SUWAYOMI_URL=http://ADRESSE_DU_NAS:4567
KOMGA_URL=

# Port d'écoute de Scrollarr sur l'hôte.
SCROLLARR_PORT=8380

# ── Notifications push (profil « push », facultatif) ──
# Suwayomi : seulement s'il demande une authentification.
SUWAYOMI_USER=
SUWAYOMI_PASSWORD=
# Komga : clé d'API créée dans Mon compte > Clés d'API.
KOMGA_API_KEY=
# Contact exigé par le protocole Web Push.
VAPID_SUBJECT=mailto:vous@exemple.fr
# Intervalle entre deux vérifications des nouveaux chapitres.
POLL_MINUTES=10
