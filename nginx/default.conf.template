# Scrollarr : fichiers statiques + proxys de même origine vers les serveurs.
# ${KOMGA_URL} et ${SUWAYOMI_URL} sont remplacés au démarrage du conteneur
# (mécanisme « templates » de l'image nginx officielle). Les deux variables
# doivent exister dans l'environnement, quitte à être vides : un serveur dont
# l'adresse est vide est simplement absent de l'application.

map "${KOMGA_URL}" $komga_on {
    ""      "false";
    default "true";
}
map "${SUWAYOMI_URL}" $suwayomi_on {
    ""      "false";
    default "true";
}
# Suwayomi en mode « basic auth » ou « simple login » : l'application garde
# l'identifiant dans un cookie, converti ici en en-tête Authorization pour que
# les images (balises <img>) soient authentifiées elles aussi.
map $cookie_scrollarr_suwa_basic $suwayomi_auth {
    ""      $http_authorization;
    default "Basic $cookie_scrollarr_suwa_basic";
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # DNS interne de Docker : permet de démarrer même si un serveur est arrêté.
    resolver 127.0.0.11 valid=30s ipv6=off;

    client_max_body_size 2m;
    gzip on;
    gzip_types text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;

    # Le service worker gère le cache de l'application : le navigateur doit
    # toujours revalider ces fichiers pour que les mises à jour arrivent.
    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }
    location ~ ^/(icons|fonts)/ {
        expires 30d;
    }

    # Serveurs configurés sur cette installation, lus par l'application au démarrage.
    # Un add_header dans un location annule l'héritage de ceux du serveur
    # (add_header_inherit n'existe qu'à partir de nginx 1.29.3, l'image est en 1.27) :
    # les trois en-têtes de sécurité sont donc répétés ici (vérifié par tests/nginx_headers.py).
    location = /servers.json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
        return 200 '{"komga":$komga_on,"suwayomi":$suwayomi_on}';
    }

    # Chaque serveur est placé sous la même origine que l'application : ses
    # cookies de session servent ainsi aux requêtes fetch comme aux images.
    location ~ ^/komga/(?<komga_path>.*)$ {
        if ($komga_on = "false") { return 404; }
        set $komga "${KOMGA_URL}";
        proxy_pass $komga/$komga_path$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        # Sans cet en-tête, un 401 ne déclenche pas la fenêtre de connexion du navigateur.
        proxy_hide_header WWW-Authenticate;
        proxy_read_timeout 120s;
    }

    location ~ ^/suwayomi/(?<suwayomi_path>.*)$ {
        if ($suwayomi_on = "false") { return 404; }
        set $suwayomi "${SUWAYOMI_URL}";
        proxy_pass $suwayomi/$suwayomi_path$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header Authorization $suwayomi_auth;
        proxy_hide_header WWW-Authenticate;
        # Un chapitre non téléchargé est d'abord récupéré chez la source : cela peut être long.
        proxy_read_timeout 180s;
    }

    # Notifications push (service facultatif, profil « push » de docker-compose).
    location /notify/ {
        set $notifier "http://notifier:8787";
        rewrite ^/notify/(.*)$ /$1 break;
        proxy_pass $notifier;
        proxy_http_version 1.1;
        proxy_set_header Cookie $http_cookie;
        proxy_read_timeout 30s;
        # Notifier absent : l'application masque simplement l'option.
        proxy_intercept_errors on;
        error_page 502 503 504 =404 /notify-unavailable;
    }
    location = /notify-unavailable {
        internal;
        default_type application/json;
        return 404 '{"error":"notifier unavailable"}';
    }
}
